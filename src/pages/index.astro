---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const HERO = {
  eyebrow: "정신건강 소프트웨어 기획·개발자",
  name: "곁 · gyeot",
  tagline: "사람을 돕는 도구를 만듭니다",
  description: `DTx(디지털치료제)보다 접근 용이하고, 가격 부담없는 앱·웹서비스를 만듭니다.`,
  tags: ["조울증(양극성장애)", "우울증", "기분장애", "PTSD(외상후스트레스장애)", "조현정동장애"],
  photo: "/assets/gyeot.jpg",
  photoAlt: "gyeot studio",
};

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="app-layout">

    <!-- ─── Hero ─────────────────────────────────────────── -->
    <section
      id="hero"
      class="grid grid-cols-[1fr_auto] gap-8 items-start
             border-b border-border pt-12 pb-10 sm:pt-16"
    >
      <!-- Left: text -->
      <div>
        <p class="eyebrow">{HERO.eyebrow}</p>

        <h1 class="hero-name">{HERO.name}</h1>

        <p class="hero-tagline">{HERO.tagline}</p>

        <p class="hero-desc">{HERO.description}</p>

        <!-- interest tags -->
        <ul class="hero-tags" aria-label="topics">
          {HERO.tags.map(tag => <li>{tag}</li>)}
        </ul>

        <!-- social links -->
        {
          SOCIALS.length > 0 && (
            <div class="mt-5 flex items-center gap-2 flex-wrap">
              <span class="text-xs text-muted">링크:</span>
              <Socials />
            </div>
          )
        }
      </div>

      <!-- Right: photo -->
      <div class="hero-photo-wrap">
        <img
          src={HERO.photo}
          alt={HERO.photoAlt}
          class="hero-photo"
          width="140"
          height="172"
        />
      </div>
    </section>

    <!-- ─── Selected Works (featured) ────────────────────── -->
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-8",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="section-label">주요 글</h2>
          <ul class="featured-grid">
            {featuredPosts.map((data, i) => (
              <li class:list={["featured-card", { accent: i === 0 }]}>
                <Card variant="h3" {...data} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- ─── Recent Posts ──────────────────────────────────── -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-8">
          <div class="section-header">
            <h2 class="section-label">최근 글</h2>
            <LinkButton
              href="/posts/"
              class="see-all-link"
            >
              전체 글
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul class="posts-list">
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && (
                  <li class="post-row">
                    <Card variant="h3" {...data} />
                  </li>
                )
            )}
          </ul>
        </section>
      )
    }

  </main>

  <Footer />
</Layout>

<style>
  /* ── Eyebrow ── */
  .eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
 
  /* ── Hero name ── */
  .hero-name {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 0.4rem;
  }
 
  /* ── Tagline ── */
  .hero-tagline {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
 
  /* ── Description ── */
  .hero-desc {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 38ch;
    margin-bottom: 1.25rem;
  }
 
  /* ── Tags ── */
  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .hero-tags li {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--color-fill);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }
 
  /* ── Photo ── */
  .hero-photo-wrap {
    flex-shrink: 0;
  }
  .hero-photo {
    width: 140px;
    height: 172px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
 
  /* ── Section label (eyebrow-style) ── */
  .section-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }
 
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }
 
  .see-all-link {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .see-all-link:hover {
    color: var(--color-accent);
  }
 
  /* ── Featured grid ── */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
 
  .featured-card {
    border: 0.5px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--color-card);
  }
 
  /* first featured card: dark accent */
  .featured-card.accent {
    background: var(--color-text-base);
    border-color: transparent;
    color: var(--color-fill);
  }
  .featured-card.accent :global(a),
  .featured-card.accent :global(h3),
  .featured-card.accent :global(p) {
    color: inherit;
  }
 
  /* ── Recent posts list ── */
  .posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-row {
    border-bottom: 0.5px solid var(--color-border);
  }
  .post-row:last-child {
    border-bottom: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>